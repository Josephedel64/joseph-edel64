function AuthPage({ onLogin, onSignup }: { onLogin: (email: string, password: string) => Promise<void>; onSignup: (name: string, email: string, password: string, plan: string) => Promise<void> }) {
  const [mode, setMode] = useState<'signin' | 'signup'>('signin');
  const [form, setForm] = useState({ name: 'Demo Agency', email: demoCredentials.email, password: demoCredentials.password, plan: 'free' });
  const [error, setError] = useState('');
  const [pending, setPending] = useState(false);

  const submit = async (event: FormEvent) => {
    event.preventDefault();
    setPending(true);
    setError('');

    try {
      if (mode === 'signin') {
        await onLogin(form.email, form.password);
      } else {
        await onSignup(form.name, form.email, form.password, form.plan);
      }
    } catch (caughtError) {
      setError(caughtError instanceof Error ? caughtError.message : 'Unable to authenticate.');
    } finally {
      setPending(false);
    }
  };

  return (
    <div className="flex min-h-screen items-center justify-center bg-slate-100 px-4 py-12">
      <div className="card w-full max-w-md overflow-hidden">
        <div className="bg-slate-900 px-6 py-5 text-white">
          <div className="flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 font-bold text-white">L</div>
            <div>
              <div className="text-xl font-bold">LeadPilot AI</div>
              <div className="text-sm text-slate-300">Agency pipeline management</div>
            </div>
          </div>
        </div>

        <div className="p-6">
          <div className="mb-4 flex rounded-xl bg-slate-100 p-1">
            {['signin', 'signup'].map((option) => (
              <button
                key={option}
                type="button"
                onClick={() => setMode(option as 'signin' | 'signup')}
                className={`flex-1 rounded-xl px-3 py-2 text-sm font-semibold ${mode === option ? 'bg-white shadow-sm text-slate-900' : 'text-slate-500'}`}
              >
                {option === 'signin' ? 'Sign in' : 'Create account'}
              </button>
            ))}
          </div>

          <form onSubmit={submit} className="space-y-4">
            {mode === 'signup' ? (
              <div>
                <label className="mb-1 block text-sm font-medium text-slate-700">Agency name</label>
                <input value={form.name} onChange={(event) => setForm({ ...form, name: event.target.value })} className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 outline-none ring-0 focus:border-brand-500" required />
              </div>
            ) : null}

            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">Email</label>
              <input type="email" value={form.email} onChange={(event) => setForm({ ...form, email: event.target.value })} className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 outline-none focus:border-brand-500" required />
            </div>

            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">Password</label>
              <input type="password" value={form.password} onChange={(event) => setForm({ ...form, password: event.target.value })} className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 outline-none focus:border-brand-500" required />
            </div>

            {mode === 'signup' ? (
              <div>
                <label className="mb-1 block text-sm font-medium text-slate-700">Plan</label>
                <select value={form.plan} onChange={(event) => setForm({ ...form, plan: event.target.value })} className="w-full rounded-xl border border-slate-200 bg-white px-3 py-2.5 outline-none focus:border-brand-500">
                  {PLAN_OPTIONS.map((plan) => (
                    <option key={plan.id} value={plan.id}>{plan.label}</option>
                  ))}
                </select>
              </div>
            ) : null}

            {error ? <div className="rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{error}</div> : null}

            <button disabled={pending} className="w-full rounded-xl bg-brand-600 px-4 py-3 font-semibold text-white disabled:cursor-not-allowed disabled:opacity-70">
              {pending ? 'Please wait...' : mode === 'signin' ? 'Sign in' : 'Create account'}
            </button>

            <div className="rounded-xl bg-amber-50 p-3 text-sm text-amber-800">
              Demo credentials: <strong>{demoCredentials.email}</strong> / <strong>{demoCredentials.password}</strong>
            </div>
          </form>
        </div>
      </div>
    </div>
  );
}

function DashboardPage({ dashboard, loading, syncMessage, setSyncMessage, onRefresh, onLogout }: {
  dashboard: DashboardData | null;
  loading: boolean;
  syncMessage: string;
  setSyncMessage: (msg: string) => void;
  onRefresh: () => Promise<void>;
  onLogout: () => void;
}) {
  const navigate = useNavigate();
  const [leads, setLeads] = useState<Lead[]>(dashboard?.leads || []);
  const [tasks, setTasks] = useState<TaskItem[]>(dashboard?.tasks || []);
  const [templates, setTemplates] = useState<TemplateItem[]>(dashboard?.templates || []);
  const [selectedLeadId, setSelectedLeadId] = useState('');
  const [draft, setDraft] = useState('');
  const [search, setSearch] = useState('');
  const [statusFilter, setStatusFilter] = useState('all');
  const [form, setForm] = useState<Lead>({ ...emptyLead, owner: 'Ava' });
  const [isEditing, setIsEditing] = useState(false);
  const [pending, setPending] = useState(false);

  useEffect(() => {
    if (dashboard) {
      setLeads(dashboard.leads);
      setTasks(dashboard.tasks);
      setTemplates(dashboard.templates);
      if (!selectedLeadId && dashboard.leads[0]) setSelectedLeadId(dashboard.leads[0].id);
    }
  }, [dashboard]);

  const filteredLeads = useMemo(() => {
    return leads.filter((lead) => {
      const matchesSearch = `${lead.name} ${lead.company} ${lead.email}`.toLowerCase().includes(search.toLowerCase());
      const matchesStatus = statusFilter === 'all' || lead.status === statusFilter;
      return matchesSearch && matchesStatus;
    });
  }, [leads, search, statusFilter]);

  const api = useApi();

  const submitLead = async (event: FormEvent) => {
    event.preventDefault();
    try {
      setPending(true);
      const method = isEditing ? 'POST' : 'POST';
      const payload = { ...form, id: isEditing ? form.id : undefined };
      const response = await api('/api/leads', { method, body: JSON.stringify(payload) });
      setSyncMessage(response.lead ? 'Lead saved successfully.' : 'Lead added.');
      await onRefresh();
      setForm({ ...emptyLead, owner: 'Ava' });
      setIsEditing(false);
    } catch (error) {
      setSyncMessage(error instanceof Error ? error.message : 'Unable to save lead.');
    } finally {
      setPending(false);
    }
  };

  const deleteLead = async (leadId: string) => {
    try {
      await api(`/api/leads/${leadId}`, { method: 'DELETE' });
      setSyncMessage('Lead removed.');
      await onRefresh();
    } catch (error) {
      setSyncMessage(error instanceof Error ? error.message : 'Unable to delete lead.');
    }
  };

  const importCsv = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;
    const text = await file.text();
    try {
      const response = await api('/api/leads/import', {
        method: 'POST',
        body: JSON.stringify({ csv: text })
      });
      setSyncMessage(`Imported ${response.count} leads successfully.`);
      await onRefresh();
    } catch (error) {
      setSyncMessage(error instanceof Error ? error.message : 'CSV import failed.');
    }
  };

  const generateAiDraft = async () => {
    if (!selectedLeadId) return;
    try {
      const response = await api('/api/ai/generate', {
        method: 'POST',
        body: JSON.stringify({ leadId: selectedLeadId, tone: 'professional' })
      });
      setDraft(response.draft);
      setSyncMessage('AI follow-up generated. Review and approve before sending.');
      await onRefresh();
    } catch (error) {
      setSyncMessage(error instanceof Error ? error.message : 'AI generation failed.');
    }
  };

  const approveTask = async (taskId: string) => {
    try {
      await api(`/api/tasks/${taskId}/approve`, { method: 'POST' });
      setSyncMessage('Follow-up approved.');
      await onRefresh();
    } catch (error) {
      setSyncMessage(error instanceof Error ? error.message : 'Approval failed.');
    }
  };

  const retryTask = async (taskId: string) => {
    try {
      await api(`/api/tasks/${taskId}/retry`, { method: 'POST' });
      setSyncMessage('Follow-up task retry scheduled.');
      await onRefresh();
    } catch (error) {
      setSyncMessage(error instanceof Error ? error.message : 'Retry failed.');
    }
  };

  const selectedLead = leads.find((lead) => lead.id === selectedLeadId) ?? leads[0];

  return (
    <div className="min-h-screen bg-slate-100 p-6 text-slate-900">
      <div className="mx-auto max-w-7xl">
        <header className="mb-8 flex flex-wrap items-center justify-between gap-3">
          <div className="flex items-center gap-3">
            <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-600 text-lg font-bold text-white">L</div>
            <div>
              <div className="text-xl font-bold">LeadPilot AI</div>
              <div className="text-sm text-slate-500">Demo agency workspace</div>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <button onClick={() => onRefresh()} className="rounded-xl border border-slate-200 bg-white px-4 py-2 font-medium text-slate-700">Refresh</button>
            <button onClick={onLogout} className="rounded-xl bg-slate-900 px-4 py-2 font-medium text-white">Log out</button>
          </div>
        </header>

        {syncMessage ? <div className="mb-6 rounded-xl border border-brand-200 bg-brand-50 px-4 py-3 text-sm text-brand-700">{syncMessage}</div> : null}

        {dashboard ? (
          <>
            <section className="mb-8 grid gap-4 md:grid-cols-4">
              {[
                { label: 'Total leads', value: dashboard.metrics.total },
                { label: 'New leads', value: dashboard.metrics.newLeads },
                { label: 'Qualified', value: dashboard.metrics.qualified },
                { label: 'AI usage', value: `${dashboard.user.usage?.aiGenerations ?? 0}/${dashboard.quota.aiGenerations}` }
              ].map((metric) => (
                <div key={metric.label} className="card p-5">
                  <div className="text-sm text-slate-500">{metric.label}</div>
                  <div className="mt-3 text-3xl font-black text-slate-900">{metric.value}</div>
                </div>
              ))}
            </section>

            <div className="grid gap-8 xl:grid-cols-[1.2fr_0.8fr]">
              <div className="space-y-6">
                <section className="card p-5">
                  <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
                    <h2 className="text-xl font-bold">Lead pipeline</h2>
                    <div className="flex flex-wrap gap-3">
                      <input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="Search leads" className="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" />
                      <select value={statusFilter} onChange={(event) => setStatusFilter(event.target.value)} className="rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500">
                        <option value="all">All statuses</option>
                        <option value="New lead">New lead</option>
                        <option value="Contacted">Contacted</option>
                        <option value="Qualified">Qualified</option>
                        <option value="Proposal">Proposal</option>
                        <option value="Lost">Lost</option>
                      </select>
                      <label className="inline-flex items-center justify-center rounded-lg bg-brand-600 px-3 py-2 text-sm font-semibold text-white">
                        <input type="file" accept=".csv" onChange={importCsv} />
                        Import CSV
                      </label>
                    </div>
                  </div>

                  <div className="overflow-x-auto">
                    <table className="min-w-full text-left text-sm">
                      <thead>
                        <tr className="border-b border-slate-200 text-slate-500">
                          <th className="pb-3 pr-4 font-medium">Lead</th>
                          <th className="pb-3 pr-4 font-medium">Company</th>
                          <th className="pb-3 pr-4 font-medium">Status</th>
                          <th className="pb-3 pr-4 font-medium">Next follow-up</th>
                          <th className="pb-3 pr-4 font-medium">Actions</th>
                        </tr>
                      </thead>
                      <tbody>
                        {filteredLeads.map((lead) => (
                          <tr key={lead.id} className={`border-b border-slate-100 ${selectedLead?.id === lead.id ? 'bg-brand-50' : ''}`}>
                            <td className="py-3 pr-4">
                              <button onClick={() => setSelectedLeadId(lead.id)} className="text-left font-medium text-slate-900">{lead.name}</button>
                            </td>
                            <td className="py-3 pr-4">{lead.company}</td>
                            <td className="py-3 pr-4"><span className="rounded-full bg-slate-100 px-2 py-1 text-xs font-medium">{lead.status}</span></td>
                            <td className="py-3 pr-4">{lead.nextFollowUp || '—'}</td>
                            <td className="py-3 pr-4">
                              <div className="flex gap-2">
                                <button onClick={() => { setForm(lead); setIsEditing(true); }} className="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs">Edit</button>
                                <button onClick={() => deleteLead(lead.id)} className="rounded-md border border-red-200 bg-red-50 px-2 py-1 text-xs text-red-700">Delete</button>
                              </div>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </section>

                <section className="card p-5">
                  <div className="mb-4 flex items-center justify-between">
                    <h2 className="text-xl font-bold">AI follow-up composer</h2>
                    <button onClick={generateAiDraft} className="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Generate draft</button>
                  </div>
                  <div className="mb-3 flex items-center gap-3">
                    <select value={selectedLeadId} onChange={(event) => setSelectedLeadId(event.target.value)} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500">
                      {leads.map((lead) => (
                        <option key={lead.id} value={lead.id}>{lead.name}</option>
                      ))}
                    </select>
                  </div>
                  <textarea value={draft || 'Select a lead and generate a personalized follow-up email.'} onChange={(event) => setDraft(event.target.value)} className="h-48 w-full rounded-xl border border-slate-200 bg-white p-3 text-sm outline-none focus:border-brand-500" />
                </section>
              </div>

              <div className="space-y-6">
                <section className="card p-5">
                  <div className="mb-4 flex items-center justify-between">
                    <h2 className="text-xl font-bold">Add or edit lead</h2>
                    {isEditing ? <button onClick={() => { setForm({ ...emptyLead, owner: 'Ava' }); setIsEditing(false); }} className="text-sm font-medium text-slate-500">Cancel</button> : null}
                  </div>
                  <form onSubmit={submitLead} className="space-y-3">
                    <input placeholder="Name" value={form.name} onChange={(event) => setForm({ ...form, name: event.target.value })} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" required />
                    <input placeholder="Company" value={form.company} onChange={(event) => setForm({ ...form, company: event.target.value })} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" required />
                    <input type="email" placeholder="Email" value={form.email} onChange={(event) => setForm({ ...form, email: event.target.value })} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" required />
                    <select value={form.status} onChange={(event) => setForm({ ...form, status: event.target.value })} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500">
                      <option value="New lead">New lead</option>
                      <option value="Contacted">Contacted</option>
                      <option value="Qualified">Qualified</option>
                      <option value="Proposal">Proposal</option>
                      <option value="Lost">Lost</option>
                    </select>
                    <input placeholder="Owner" value={form.owner} onChange={(event) => setForm({ ...form, owner: event.target.value })} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" required />
                    <input placeholder="Source" value={form.source} onChange={(event) => setForm({ ...form, source: event.target.value })} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" />
                    <textarea placeholder="Notes" value={form.notes} onChange={(event) => setForm({ ...form, notes: event.target.value })} className="h-24 w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" />
                    <div className="grid gap-3 sm:grid-cols-2">
                      <input type="date" value={form.lastContact} onChange={(event) => setForm({ ...form, lastContact: event.target.value })} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" />
                      <input type="date" value={form.nextFollowUp} onChange={(event) => setForm({ ...form, nextFollowUp: event.target.value })} className="w-full rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm outline-none focus:border-brand-500" />
                    </div>
                    <label className="flex items-center gap-2 text-sm text-slate-700"><input type="checkbox" checked={form.optedOut} onChange={(event) => setForm({ ...form, optedOut: event.target.checked })} /> Contact opted out</label>
                    <button type="submit" disabled={pending} className="w-full rounded-lg bg-brand-600 px-4 py-2.5 font-semibold text-white disabled:cursor-not-allowed disabled:opacity-70">{pending ? 'Saving...' : isEditing ? 'Update lead' : 'Create lead'}</button>
                  </form>
                </section>

                <section className="card p-5">
                  <h2 className="mb-3 text-xl font-bold">Follow-up queue</h2>
                  <div className="space-y-3">
                    {tasks.length ? tasks.map((task) => (
                      <div key={task.id} className="rounded-xl border border-slate-200 bg-slate-50 p-3">
                        <div className="flex items-center justify-between gap-2">
                          <div className="font-semibold text-slate-900">{task.leadName}</div>
                          <span className="rounded-full bg-brand-100 px-2 py-1 text-xs font-medium text-brand-700">{task.status}</span>
                        </div>
                        <div className="mt-2 text-sm text-slate-600">{task.templateName}</div>
                        <div className="mt-2 text-xs text-slate-500">Due {new Date(task.dueAt).toLocaleString()}</div>
                        <div className="mt-3 flex gap-2">
                          <button onClick={() => approveTask(task.id)} className="rounded-md bg-slate-900 px-2 py-1 text-xs font-medium text-white">Approve</button>
                          <button onClick={() => retryTask(task.id)} className="rounded-md border border-slate-200 bg-white px-2 py-1 text-xs font-medium text-slate-700">Retry</button>
                        </div>
                      </div>
                    )) : <div className="text-sm text-slate-500">No tasks in the queue.</div>}
                  </div>
                </section>
              </div>
            </div>
          </>
        ) : (
          <div className="card flex min-h-[200px] items-center justify-center p-8 text-slate-500">Loading dashboard...</div>
        )}
      </div>
    </div>
  );
}

export default App;
