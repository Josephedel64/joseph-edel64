import { useEffect, useMemo, useState } from 'react';
import { Link, Navigate, Route, Routes, useNavigate } from 'react-router-dom';
import type { FormEvent } from 'react';

const PLAN_OPTIONS = [
  { id: 'free', label: 'Free', price: '$0', description: 'Up to 10 leads and 10 AI generations per month.' },
  { id: 'starter', label: 'Starter', price: '$19', description: 'Best for solo agencies and small pipelines.' },
  { id: 'pro', label: 'Pro', price: '$49', description: 'Built for active pipeline management and team workflows.' }
];

interface User {
  id: string;
  name: string;
  email: string;
  plan: string;
  usage?: { aiGenerations: number; month: string };
}

interface Lead {
  id: string;
  name: string;
  company: string;
  email: string;
  source: string;
  status: string;
  notes: string;
  lastContact: string;
  nextFollowUp: string;
  owner: string;
  optedOut: boolean;
  ownerId?: string;
}

interface TaskItem {
  id: string;
  leadId: string;
  leadName: string;
  templateId: string;
  templateName: string;
  dueAt: string;
  status: string;
  attempts: number;
  retriesRemaining: number;
  approvalState: string;
  message: string;
  error?: string;
}

interface TemplateItem {
  id: string;
  name: string;
  timingHours: number;
  subject: string;
  body: string;
}

interface DashboardData {
  user: User;
  leads: Lead[];
  tasks: TaskItem[];
  templates: TemplateItem[];
  metrics: {
    total: number;
    newLeads: number;
    qualified: number;
    inProgress: number;
    optedOut: number;
  };
  quota: { leadCap: number; aiGenerations: number };
  planOptions: string[];
}

const emptyLead: Omit<Lead, 'id' | 'ownerId'> = {
  name: '',
  company: '',
  email: '',
  source: 'Website',
  status: 'New lead',
  notes: '',
  lastContact: '',
  nextFollowUp: '',
  owner: 'Demo owner',
  optedOut: false
};

const demoCredentials = { email: 'demo@leadpilot.ai', password: 'password123' };

const formatCurrency = (amount: number) => `$${amount.toFixed(0)}`;

function useApi() {
  const token = localStorage.getItem('leadpilot-token') || '';

  return async function request(path: string, options: RequestInit = {}) {
    const response = await fetch(path, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
        ...(options.headers || {})
      }
    });

    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(payload.error || 'Something went wrong.');
    }

    return payload;
  };
}

function App() {
  const [token, setToken] = useState(localStorage.getItem('leadpilot-token') || '');
  const [user, setUser] = useState<User | null>(() => {
    const raw = localStorage.getItem('leadpilot-user');
    return raw ? JSON.parse(raw) : null;
  });
  const [dashboard, setDashboard] = useState<DashboardData | null>(null);
  const [loading, setLoading] = useState(false);
  const [syncMessage, setSyncMessage] = useState('');
  const navigate = useNavigate();

  const api = useApi();

  useEffect(() => {
    if (!token) {
      localStorage.removeItem('leadpilot-token');
      localStorage.removeItem('leadpilot-user');
      setUser(null);
      return;
    }

    localStorage.setItem('leadpilot-token', token);
    const loadDashboard = async () => {
      try {
        setLoading(true);
        const data = await api('/api/dashboard');
        setDashboard(data);
        setUser(data.user);
        localStorage.setItem('leadpilot-user', JSON.stringify(data.user));
      } catch (error) {
        setSyncMessage(error instanceof Error ? error.message : 'Unable to load dashboard.');
      } finally {
        setLoading(false);
      }
    };

    loadDashboard();
  }, [token]);

  const handleLogin = async (email: string, password: string) => {
    const response = await api('/api/auth/login', {
      method: 'POST',
      body: JSON.stringify({ email, password })
    });

    setToken(response.token);
    setUser(response.user);
    localStorage.setItem('leadpilot-user', JSON.stringify(response.user));
    navigate('/dashboard');
  };

  const handleSignup = async (name: string, email: string, password: string, plan: string) => {
    const response = await api('/api/auth/signup', {
      method: 'POST',
      body: JSON.stringify({ name, email, password, plan })
    });

    setToken(response.token);
    setUser(response.user);
    localStorage.setItem('leadpilot-user', JSON.stringify(response.user));
    navigate('/dashboard');
  };

  const handleLogout = () => {
    setToken('');
    setUser(null);
    setDashboard(null);
    localStorage.removeItem('leadpilot-token');
    localStorage.removeItem('leadpilot-user');
    navigate('/');
  };

  const refreshDashboard = async () => {
    try {
      const data = await api('/api/dashboard');
      setDashboard(data);
      setUser(data.user);
      localStorage.setItem('leadpilot-user', JSON.stringify(data.user));
    } catch (error) {
      setSyncMessage(error instanceof Error ? error.message : 'Unable to refresh data.');
    }
  };

  const isAuthenticated = Boolean(token && user);

  return (
    <Routes>
      <Route path="/" element={<LandingPage user={user} onLogout={handleLogout} />} />
      <Route path="/pricing" element={<PricingPage user={user} onLogout={handleLogout} />} />
      <Route
        path="/login"
        element={
          isAuthenticated ? (
            <Navigate to="/dashboard" replace />
          ) : (
            <AuthPage onLogin={handleLogin} onSignup={handleSignup} />
          )
        }
      />
      <Route
        path="/dashboard"
        element={
          isAuthenticated ? (
            <DashboardPage
              dashboard={dashboard}
              loading={loading}
              syncMessage={syncMessage}
              setSyncMessage={setSyncMessage}
              onRefresh={refreshDashboard}
              onLogout={handleLogout}
            />
          ) : (
            <Navigate to="/login" replace />
          )
        }
      />
    </Routes>
  );
}

